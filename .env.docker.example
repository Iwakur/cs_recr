# Copy this file to .env.docker, set mode 600, and replace both passwords.
# Never commit .env.docker.

# For a local build, keep this value. On the VPS, use the immutable GHCR tag:
# ghcr.io/your-github-owner/your-repository:sha-full-commit-hash
APP_IMAGE=cansat-recruitment:local

# Pin this to a tested MariaDB 11.4 patch tag or digest before production.
MARIADB_IMAGE=mariadb:11.4

# The host Caddy reverse-proxies to http://127.0.0.1:8080.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

DB_NAME=cansat
DB_USER=cansat_app

# DB_PASSWORD is shared intentionally: Compose gives the same value to
# web as DB_PASS and to MariaDB as MARIADB_PASSWORD.
DB_PASSWORD=replace-with-a-long-random-application-password

# This is only for database administration, initialization, and SQL dumps.
# It must be different from DB_PASSWORD.
DB_ROOT_PASSWORD=replace-with-a-different-long-random-root-password
